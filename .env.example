# ─────────────────────────────────────────────────────
# REQUIRED — site cannot run without these
# ─────────────────────────────────────────────────────

# Supabase (DB, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ImagineThisAuction


# ─────────────────────────────────────────────────────
# RECOMMENDED — features degrade gracefully without these
# ─────────────────────────────────────────────────────

# OpenAI - powers AI copywriter, listing assistant, hype previews
# Without: /api/ai/* routes return errors; admin "Generate copy" buttons fail.
OPENAI_API_KEY=

# Resend - sends transactional emails (auction won, outbid, daily digests)
# Without: emails silently skip; in-app notifications still work.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────
# OPTIONAL — only needed for specific feature areas
# ─────────────────────────────────────────────────────

# Web Push notifications (browser push for outbid/winning alerts)
# Generate with: npx web-push generate-vapid-keys
# Without: push subscribe button shows error; in-app + email still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@imaginethisauction.com

# Payments (NMI via PaymentCloud) - see docs/PAYMENTS.md
# One NMI gateway; each auctioneer has their own merchant account (processor_id)
# under it. Bidders keep one card in the gateway Customer Vault via Collect.js.
# Without NMI_SECURITY_KEY outside production: NMI's public sandbox key is used
# and a warning is logged once. In production a missing key throws.
# Without NMI_WEBHOOK_SIGNING_KEY: /api/webhooks/nmi rejects every event (500).
NMI_SECURITY_KEY=
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=
NMI_WEBHOOK_SIGNING_KEY=
NMI_PLATFORM_PROCESSOR_ID=
NMI_API_URL=https://secure.nmi.com/api/transact.php

# Replicate - powers AI presentation images (clean background, studio, lifestyle)
# Without: the Quick List image tools stay disabled and report "not configured";
# listing drafts and identification still work.
REPLICATE_API_TOKEN=

# Barcode Lookup (optional, paid) - a second product-data source for UPC/EAN.
# Without: Quick List still uses Open Library (ISBN) and UPCitemdb (UPC/EAN),
# both keyless, plus photo understanding.
BARCODE_LOOKUP_API_KEY=

# Demo mode - bidding bots, auto-reset, time acceleration
# Without: demo control panel inert. Production unaffected.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_AUCTIONEER_PASSWORD=
DEMO_BIDDER_PASSWORD=

# Supabase CLI (only used by `supabase db push` for migrations)
SUPABASE_DB_PASSWORD=
