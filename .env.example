# ─────────────────────────────────────────────────────
# REQUIRED — site cannot run without these
# ─────────────────────────────────────────────────────

# Supabase (DB, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ImagineThisAuction


# ─────────────────────────────────────────────────────
# RECOMMENDED — features degrade gracefully without these
# ─────────────────────────────────────────────────────

# OpenAI - powers AI copywriter, listing assistant, hype previews
# Without: /api/ai/* routes return errors; admin "Generate copy" buttons fail.
OPENAI_API_KEY=

# Resend - sends transactional emails (auction won, outbid, daily digests)
# Without: emails silently skip; in-app notifications still work.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────
# OPTIONAL — only needed for specific feature areas
# ─────────────────────────────────────────────────────

# Web Push notifications (browser push for outbid/winning alerts)
# Generate with: npx web-push generate-vapid-keys
# Without: push subscribe button shows error; in-app + email still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@imaginethisauction.com

# PaymentCloud - real credit-card payments (currently STUB in code, see audit)
# Without: credit-pack purchases fail at checkout. Wallet display still works.
NEXT_PUBLIC_PAYMENT_PROVIDER=paymentcloud
PAYMENTCLOUD_API_KEY=
PAYMENTCLOUD_WEBHOOK_SECRET=

# Demo mode - bidding bots, auto-reset, time acceleration
# Without: demo control panel inert. Production unaffected.
NEXT_PUBLIC_DEMO_MODE=false
DEMO_AUCTIONEER_PASSWORD=
DEMO_BIDDER_PASSWORD=

# Supabase CLI (only used by `supabase db push` for migrations)
SUPABASE_DB_PASSWORD=
